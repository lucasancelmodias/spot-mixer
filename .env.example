# Copy this file to .env and fill in the values. Never commit .env.

# Spotify app: Developer Dashboard > your app > Settings.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI in the dashboard exactly. Use 127.0.0.1, never localhost.
# Its origin (here http://127.0.0.1:5173) is the address of the app in the browser.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
# Two-letter country code of the users, for catalog reads. Default: US.
# SPOTIFY_MARKET=US

# Encrypts the Spotify tokens in Redis: 32 random bytes, base64. A new key signs everyone out.
# Make one with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
TOKEN_ENC_KEY=

# API server. The defaults are shown; uncomment a line to change it.
# HOST=127.0.0.1
# PORT=3000
# REDIS_URL=redis://127.0.0.1:6380
